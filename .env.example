# OpenRouter
OPENROUTER_API_KEY=sk-or-v1-your-key-here
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Retrieval
EMBEDDING_MODEL=openai/text-embedding-3-small
# Semantic chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150
SEMANTIC_MIN_CHUNK_SIZE=150
SEMANTIC_BREAKPOINT_PERCENTILE=80
SEMANTIC_MIN_BREAKPOINT_DISTANCE=0.10
SEMANTIC_CONTEXT_WINDOW=1
TOP_K=4

# Storage
DATA_DIR=data
DB_PATH=data/workmind.db
VECTOR_DB_DIR=data/vector-store
